    "gender_matches = [c for c in X_test.columns if c.strip().lower() == \"gender\"]\n",
    "assert len(gender_matches) == 1, f\"Expected one gender column, found {gender_matches}\"\n",
    "gender_col = gender_matches[0]\n",
    "audit = test_result.copy()\n",
    "audit[\"gender\"] = X_test.loc[audit.index, gender_col].astype(\"string\")\n",
    "\n",
    "def neural_group_rates(group):\n",
    "    actual=group[\"actual\"].to_numpy(); pred=group[\"predicted\"].to_numpy()\n",
    "    tn,fp,fn,tp=confusion_matrix(actual,pred,labels=[0,1]).ravel()\n",
    "    both_classes=len(np.unique(actual))==2\n",
    "    return pd.Series({\n",
    "        \"n\":len(group),\n",
    "        \"smoking_prevalence\":actual.mean(),\n",
    "        \"accuracy\":(actual==pred).mean(),\n",
    "        \"balanced_accuracy\":balanced_accuracy_score(actual,pred) if both_classes else np.nan,\n",
    "        \"smoking_recall\":tp/(tp+fn) if (tp+fn) else np.nan,\n",
    "        \"specificity\":tn/(tn+fp) if (tn+fp) else np.nan,\n",
    "        \"false_positive_rate\":fp/(fp+tn) if (fp+tn) else np.nan,\n",
    "        \"false_negative_rate\":fn/(fn+tp) if (fn+tp) else np.nan,\n",
    "        \"both_classes_present\":both_classes,\n",
    "    })\n",
    "\n",
    "gender_audit = audit.groupby(\"gender\", dropna=False).apply(neural_group_rates, include_groups=False)\n",
    "display(gender_audit.style.format({\n",
    "    c:\"{:.3f}\" for c in gender_audit.columns if c not in [\"n\",\"both_classes_present\"]\n",
    "}))\n",
    "warnings = gender_audit[(gender_audit[\"n\"]<30) | (~gender_audit[\"both_classes_present\"])].index.tolist()\n",
    "if warnings:\n",
    "    print(\"Caution: small or single-class groups:\", warnings)\n"
