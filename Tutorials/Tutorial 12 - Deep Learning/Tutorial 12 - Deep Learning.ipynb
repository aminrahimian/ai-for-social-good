  {
   "cell_type": "markdown",
   "id": "3f16abb2",
   "metadata": {},
   "source": [
    "### <img src=\"tutorial-icons/reference_solution.png\" alt=\"Reference Solution\" width=\"30\" style=\"vertical-align:middle; margin-right:8px;\"> Reference Solution for Task 9"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "118a3fc5",
   "metadata": {},
   "outputs": [],
   "source": [
    "import numpy as np\n",
    "import pandas as pd\n",
    "\n",
    "tokens = [\"she\", \"sat\", \"river\", \"bank\"]\n",
    "X = np.array([\n",
    "    [1.0, 0.0, 0.5],\n",
    "    [0.2, 1.0, 0.0],\n",
    "    [0.0, 0.4, 1.0],\n",
    "    [0.8, 0.2, 0.6],\n",
    "])\n",
    "W_Q = np.array([[0.8, 0.1], [0.2, 0.7], [0.4, 0.5]])\n",
    "W_K = np.array([[0.6, 0.3], [0.1, 0.8], [0.7, 0.2]])\n",
    "W_V = np.array([[0.5, 0.4], [0.9, 0.1], [0.2, 0.8]])\n",
    "\n",
    "Q, K, V = X @ W_Q, X @ W_K, X @ W_V\n",
    "scores = Q @ K.T / np.sqrt(K.shape[1])\n",
    "causal_mask = np.triu(np.full_like(scores, -np.inf), k=1)\n",
    "masked_scores = scores + causal_mask\n",
    "\n",
    "shifted = masked_scores - np.max(masked_scores, axis=1, keepdims=True)\n",
    "weights = np.exp(shifted)\n",
    "weights = weights / weights.sum(axis=1, keepdims=True)\n",
    "attention_output = weights @ V\n",
    "\n",
    "print(\"Masked attention scores\")\n",
    "display(pd.DataFrame(masked_scores, index=tokens, columns=tokens).round(3))\n",
    "print(\"Attention weights\")\n",
    "display(pd.DataFrame(weights, index=tokens, columns=tokens).round(3))\n",
    "print(\"Attention output\")\n",
    "display(pd.DataFrame(attention_output, index=tokens,\n",
    "                     columns=[\"value_1\", \"value_2\"]).round(3))\n",
    "np.testing.assert_allclose(weights.sum(axis=1), 1.0)\n",
    "print(\"Verified: each attention row sums to 1.\")"
   ]
  },
