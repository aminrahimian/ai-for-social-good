    "import matplotlib.pyplot as plt\n",
    "from sklearn.metrics import (\n",
    "    ConfusionMatrixDisplay,\n",
    "    accuracy_score,\n",
    "    confusion_matrix,\n",
    "    precision_score,\n",
    "    recall_score,\n",
    "    roc_auc_score,\n",
    "    roc_curve,\n",
    ")\n",
    "\n",
    "y_pred_050 = (purchase_probability >= 0.50).astype(int)\n",
    "cm = confusion_matrix(y_test, y_pred_050)\n",
    "tn, fp, fn, tp = cm.ravel()\n",
    "\n",
    "specificity = tn / (tn + fp) if (tn + fp) else 0.0\n",
    "\n",
    "metric_table = pd.DataFrame(\n",
    "    {\n",
    "        \"Metric\": [\n",
    "            \"Accuracy\",\n",
    "            \"Precision\",\n",
    "            \"Sensitivity / Recall\",\n",
    "            \"Specificity\",\n",
    "            \"ROC AUC\",\n",
    "        ],\n",
    "        \"Value\": [\n",
    "            accuracy_score(y_test, y_pred_050),\n",
    "            precision_score(y_test, y_pred_050, zero_division=0),\n",
    "            recall_score(y_test, y_pred_050, zero_division=0),\n",
    "            specificity,\n",
    "            roc_auc_score(y_test, purchase_probability),\n",
    "        ],\n",
    "    }\n",
    ")\n",
    "\n",
    "display(metric_table.style.format({\"Value\": \"{:.3f}\"}))\n",
    "\n",
    "ConfusionMatrixDisplay(\n",
    "    confusion_matrix=cm,\n",
    "    display_labels=[\"No purchase\", \"Purchase\"],\n",
    ").plot(values_format=\"d\")\n",
    "plt.title(\"Logistic Regression Confusion Matrix at Threshold 0.50\")\n",
    "plt.show()\n",
    "\n",
    "fpr, tpr, thresholds = roc_curve(y_test, purchase_probability)\n",
    "roc_auc = roc_auc_score(y_test, purchase_probability)\n",
    "\n",
    "fig, ax = plt.subplots(figsize=(7, 6))\n",
    "ax.plot(fpr, tpr, label=f\"Logistic regression, AUC = {roc_auc:.3f}\")\n",
    "ax.plot([0, 1], [0, 1], linestyle=\"--\", label=\"No-skill reference\")\n",
    "ax.set_xlabel(\"False Positive Rate\")\n",
    "ax.set_ylabel(\"True Positive Rate\")\n",
    "ax.set_title(\"ROC Curve\")\n",
