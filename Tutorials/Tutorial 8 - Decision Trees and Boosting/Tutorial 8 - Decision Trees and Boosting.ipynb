   "metadata": {},
   "outputs": [],
   "source": [
    "from sklearn.model_selection import GridSearchCV, StratifiedKFold\n",
    "\n",
    "pruning_pipeline = Pipeline([\n",
    "    (\"preprocess\", categorical_preprocessor),\n",
    "    (\"tree\", DecisionTreeClassifier(class_weight=\"balanced\", random_state=1099)),\n",
    "])\n",
    "pruning_cv = StratifiedKFold(n_splits=5, shuffle=True, random_state=1099)\n",
    "pruning_grid = {\n",
    "    \"tree__max_depth\": [3, 5, 8, None],\n",
    "    \"tree__min_samples_leaf\": [1, 5, 15],\n",
    "    \"tree__ccp_alpha\": [0.0, 0.0005, 0.001, 0.005],\n",
    "}\n",
    "pruned_tree_search = GridSearchCV(\n",
    "    pruning_pipeline, pruning_grid, scoring=\"balanced_accuracy\",\n",
    "    cv=pruning_cv, n_jobs=-1, refit=True\n",
    ")\n",
    "pruned_tree_search.fit(X_train, y_train)\n",
    "pruned_tree = pruned_tree_search.best_estimator_\n",
    "print(\"Best parameters:\", pruned_tree_search.best_params_)\n",
    "print(\"Best CV balanced accuracy:\", round(pruned_tree_search.best_score_, 3))\n",
    "\n",
    "pruned_pred = pruned_tree.predict(X_test)\n",
    "pruned_prob = pruned_tree.predict_proba(X_test)[:, 1]\n",
    "pruned_metrics = pd.Series({\n",
    "    \"Accuracy\": accuracy_score(y_test, pruned_pred),\n",
    "    \"Balanced accuracy\": balanced_accuracy_score(y_test, pruned_pred),\n",
    "    \"Precision (poisonous)\": precision_score(y_test, pruned_pred, zero_division=0),\n",
    "    \"Recall (poisonous)\": recall_score(y_test, pruned_pred, zero_division=0),\n",
    "    \"ROC AUC\": roc_auc_score(y_test, pruned_prob),\n",
    "})\n",
    "display(pruned_metrics.to_frame(\"value\").style.format(\"{:.3f}\"))\n"
   ]
