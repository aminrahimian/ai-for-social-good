   "source": [
    "### <img src=\"tutorial-icons/reference_solution.png\" alt=\"Reference Solution\" width=\"30\" style=\"vertical-align:middle; margin-right:8px;\"> Reference Solution for Task 2\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "1e3ee55e",
   "metadata": {},
   "outputs": [],
   "source": [
    "import numpy as np\n",
    "from sklearn.model_selection import train_test_split\n",
    "from sklearn.pipeline import Pipeline\n",
    "from sklearn.impute import SimpleImputer\n",
    "from sklearn.preprocessing import OneHotEncoder\n",
    "\n",
    "X = mushrooms.drop(columns=\"class\").replace(\"?\", np.nan)\n",
    "y = mushrooms[\"class\"].map({\"e\": 0, \"p\": 1})\n",
    "assert y.notna().all(), \"Unexpected response code.\"\n",
    "\n",
    "X_train, X_test, y_train, y_test = train_test_split(\n",
    "    X, y.astype(int), test_size=0.20, random_state=1099, stratify=y\n",
    ")\n",
    "\n",
    "categorical_preprocessor = Pipeline([\n",
    "    (\"impute\", SimpleImputer(strategy=\"most_frequent\")),\n",
    "    (\"onehot\", OneHotEncoder(handle_unknown=\"ignore\", sparse_output=False)),\n",
    "])\n",
    "\n",
    "print(\"Training shape:\", X_train.shape)\n",
    "print(\"Test shape:\", X_test.shape)\n",
    "print(\"Training class proportions:\")\n",
    "display(y_train.value_counts(normalize=True).sort_index().to_frame(\"proportion\"))\n",
    "print(\"Test class proportions:\")\n",
    "display(y_test.value_counts(normalize=True).sort_index().to_frame(\"proportion\"))\n"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "a4472ebc",
